# Copy to ~/.config/vcad-audit.env and fill in.
VCAD_REPO_URL=git@github.com:developer180527/vCAD.git
VCAD_BRANCH=main
VCAD_AUDIT_HOME=%h/vcad-audit
# The server's own toolchain. Qt and pybind11 should be installed so the shell probe and the Python
# bindings are BUILT: code that compiles nowhere is code that drifts where no check can see it.
VCAD_CMAKE_ARGS=-DCMAKE_TOOLCHAIN_FILE=/opt/vcpkg/scripts/buildsystems/vcpkg.cmake
# Any command that reads a message on stdin. Only runs on failure or regression.
# VCAD_NOTIFY_CMD=curl -s -H "Title: vCAD audit" --data-binary @- https://ntfy.sh/your-private-topic
VCAD_KEEP_DAYS=30
